;======================================================
; SPLITTER_SA
;======================================================
[SPLITTER_SA.NT]
Include = ks.inf, wdmaudio.inf
Needs   = KS.Registration, WDMAUDIO.Registration
CopyFiles = SPLITTER_SA.CopyList
AddReg  = SPLITTER_SA.AddReg

[SPLITTER_SA.NT.Interfaces]
; cable 1: "Splitter 1" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender1%, SPLITTER.I.TopologyRender1
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender1%, SPLITTER.I.TopologyRender1
; cable 1: "Splitter 1 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture1%, SPLITTER.I.TopologyCapture1
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture1%, SPLITTER.I.TopologyCapture1
; cable 2: "Splitter 2" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender2%, SPLITTER.I.TopologyRender2
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender2%, SPLITTER.I.TopologyRender2
; cable 2: "Splitter 2 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture2%, SPLITTER.I.TopologyCapture2
