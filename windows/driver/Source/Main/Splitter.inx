[SPLITTER_SA.NT.Services]
AddService = Splitter,0x00000002,Splitter_Service_Inst

[Splitter_Service_Inst]
DisplayName   = %Splitter.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\splitter.sys

[SPLITTER_SA.NT.HW]
