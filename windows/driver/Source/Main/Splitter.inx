;
; Splitter: BananaSplit's own virtual cables, one for each of its eleven
; channels.
;
; Cables 1..6 belong to input strips 1..6. Cable N is two endpoints:
; "Splitter N" (a playback device apps play into) and "Splitter N Output"
; (a recording device; BananaSplit's input strip N records it).
;
; Cables 7..11 belong to buses A1, A2, A3, B1 and B2, the other way round:
; "Splitter B1 Input" (say; a playback device that bus B1 plays into) and
; "Splitter B1" (a recording device: apps pick it as their microphone).
;
; Derived from SimpleAudioSample.inx of Microsoft's Windows-driver-samples
; (Copyright (c) Microsoft Corporation, MS-PL; see LICENSE-MS-PL.txt).
; This file is a template: stampinf fills in $ARCH$ and $KMDFVERSION$ at
; build time. Keep the KSNAME_* strings in step with Filters\minipairs.h and
; the *NameGUID strings with Inc\endpoints.h.
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/28/2026,0.2.1.0
CatalogFile = splitter.cat
PnpLockDown = 1

[SourceDisksNames]
222 = %DiskName%,"",222

[SourceDisksFiles]
splitter.sys = 222

[Manufacturer]
%MfgName% = SPLITTER,NT$ARCH$.10.0...19041

; Windows 10 2004 (build 19041) and later.
[SPLITTER.NT$ARCH$.10.0...19041]
%SPLITTER_SA.DeviceDesc% = SPLITTER_SA, ROOT\Splitter

[DestinationDirs]
SPLITTER_SA.CopyList = 13 ; 13 = Package's DriverStore directory

;======================================================
; SPLITTER_SA
;======================================================
[SPLITTER_SA.CopyList]
splitter.sys

[SPLITTER_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,splitter.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%SPLITTER_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%SPLITTER_SA.DeviceDesc%

; The endpoints' numbered names (see Inc\endpoints.h). KS looks for a pin's
; name in the device's software key first (Windows 10 1809 and later), so
; nothing outside HKR is written.

HKR,MediaCategories\%Render1NameGUID%,Name,,%Render1Name%
HKR,MediaCategories\%Render1NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture1NameGUID%,Name,,%Capture1Name%
HKR,MediaCategories\%Capture1NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render2NameGUID%,Name,,%Render2Name%
HKR,MediaCategories\%Render2NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture2NameGUID%,Name,,%Capture2Name%
HKR,MediaCategories\%Capture2NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render3NameGUID%,Name,,%Render3Name%
HKR,MediaCategories\%Render3NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture3NameGUID%,Name,,%Capture3Name%
HKR,MediaCategories\%Capture3NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render4NameGUID%,Name,,%Render4Name%
HKR,MediaCategories\%Render4NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture4NameGUID%,Name,,%Capture4Name%
HKR,MediaCategories\%Capture4NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render5NameGUID%,Name,,%Render5Name%
HKR,MediaCategories\%Render5NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture5NameGUID%,Name,,%Capture5Name%
HKR,MediaCategories\%Capture5NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render6NameGUID%,Name,,%Render6Name%
HKR,MediaCategories\%Render6NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture6NameGUID%,Name,,%Capture6Name%
HKR,MediaCategories\%Capture6NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render7NameGUID%,Name,,%Render7Name%
HKR,MediaCategories\%Render7NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture7NameGUID%,Name,,%Capture7Name%
HKR,MediaCategories\%Capture7NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render8NameGUID%,Name,,%Render8Name%
HKR,MediaCategories\%Render8NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture8NameGUID%,Name,,%Capture8Name%
HKR,MediaCategories\%Capture8NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Render9NameGUID%,Name,,%Render9Name%
HKR,MediaCategories\%Render9NameGUID%,Display,1,00,00,00,00
HKR,MediaCategories\%Capture9NameGUID%,Name,,%Capture9Name%
