+
+/// Endpoints of the Splitter driver (any of its six cables).
+pub fn is_splitter(name: &str) -> bool {
+    name.to_ascii_lowercase()
+        .ends_with(&format!("({})", SPLITTER_DEVICE.to_ascii_lowercase()))
